# Content uses Supabase when configured. Set CONTENT_SOURCE=local to force the bundled archive.
CONTENT_SOURCE=supabase

# Public site configuration used by canonical URLs, sitemap, robots and sharing cards.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.org

# Optional Google integrations. Leave empty until each service is configured.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Comma-separated emails allowed to create blog drafts and publications.
CONTENT_ADMIN_EMAILS=editor@tu-dominio.org

# Supabase public runtime configuration
# Use the publishable key here, never the secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only fallback names accepted by the current Supabase local setup.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Never expose this value to the browser or commit it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Conecta: server-only session signing secret. Use a long random value.
CONECTA_SESSION_SECRET=replace-with-a-long-random-secret

# Production-safe default. The prototype mode is allowed only in local development.
CONECTA_OTP_MODE=whatsapp
